            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to_district_id\": 1915,\n  \"to_ward_code\": \"1B2101\",\n  \"weight_gram\": 5000,\n  \"length_cm\": 20,\n  \"width_cm\": 20,\n  \"height_cm\": 20\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/shipping-fee",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
